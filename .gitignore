# Build and test output
/bin/
/dist/
*.test
*.out
coverage.*
bench.txt
/testdata/fuzz-corpus/

# Fuzz corpora that go test writes for failing inputs are kept under
# <pkg>/testdata/fuzz/ and ARE committed (they are regression tests).

# Local data that must never be committed (06 §4): geoid grids, DEM tiles,
# keys, environment files.
/local/
*.pgm
*.tif
*.tiff
*.pem
*.key
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Tooling caches
/.golangci-cache/
/.staticcheck/
