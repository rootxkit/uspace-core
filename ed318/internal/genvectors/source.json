{
  "daylight": {
    "2026-10-02": {"BMCT": "2026-10-02T02:31:00Z", "EECT": "2026-10-02T14:58:00Z"},
    "2026-10-03": {"BMCT": "2026-10-03T02:32:00Z", "EECT": "2026-10-03T14:56:00Z"},
    "2026-10-04": {"BMCT": "2026-10-04T02:33:00Z", "EECT": "2026-10-04T14:54:00Z"}
  },
  "cases": [
    {
      "name": "accept-authority-collection",
      "kind": "parse",
      "expected": {"accepted": true, "export": "$document"},
      "why": "An authority-authored collection using every ED-318 property is accepted and written back equal by value: a USPACE airspace whose extendedProperties carry the 2021/664 Art. 3(4) block, a DAR restriction between daylight events in feet, a weekday REQ_AUTHORIZATION zone with a hole up to a WGS84 limit, a two-layer GeometryCollection, and references given without limits. Every refusal below is this collection with one change."
    },
    {
      "name": "refuse-unknown-property",
      "kind": "parse",
      "patch": [{"op": "add", "path": "/features/2/properties/colour", "value": "red"}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "features[2].properties.colour", "reason_contains": "unknown property"}},
      "why": "UASZone properties are closed in the ED-318 schema (additionalProperties false); extensions go in extendedProperties."
    },
    {
      "name": "refuse-ed269-spelling-of-req-authorization",
      "kind": "parse",
      "patch": [{"op": "replace", "path": "/features/2/properties/type", "value": "REQ_AUTHORISATION"}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "features[2].properties.type", "reason_contains": "ED-318 spells it REQ_AUTHORIZATION"}},
      "why": "ED-318 spells the type with a Z; the ED-269 spelling in an ED-318 file is refused by name, never normalised (LESSONS Z-04)."
    },
    {
      "name": "refuse-unknown-daylight-event",
      "kind": "parse",
      "patch": [{"op": "replace", "path": "/features/1/properties/limitedApplicability/0/schedule/0/startEvent", "value": "NOON"}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "schedule[0].startEvent", "reason_contains": "is not one of BMCT, SR, SS, EECT"}},
      "why": "ED-318 CodeDaylightEventType has four values; a period that names another cannot be evaluated and is refused."
    },
    {
      "name": "refuse-time-and-event-at-one-end",
      "kind": "parse",
      "patch": [{"op": "add", "path": "/features/1/properties/limitedApplicability/0/schedule/0/startTime", "value": "06:00:00Z"}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "schedule[0].startEvent", "reason_contains": "give one of them"}},
      "why": "A window starts at a clock time or at an event; with both, which one is meant is a guess."
    },
    {
      "name": "refuse-limit-without-reference",
      "kind": "parse",
      "patch": [{"op": "remove", "path": "/features/2/geometry/layer/upperReference"}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "layer.upperReference", "reason_contains": "without its reference"}},
      "why": "A vertical limit is judged in its datum (LESSONS D-01); a value without AGL, AMSL or WGS84 cannot be judged."
    },
    {
      "name": "refuse-no-zone-authority",
      "kind": "parse",
      "patch": [{"op": "replace", "path": "/features/4/properties/zoneAuthority", "value": []}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "features[4].properties.zoneAuthority", "reason_contains": "at least one"}},
      "why": "zoneAuthority is required with at least one entry in the ED-318 schema (ED-269 allowed an empty list)."
    },
    {
      "name": "refuse-ed269-only-reason",
      "kind": "parse",
      "patch": [{"op": "replace", "path": "/features/2/properties/reason", "value": ["FOREIGN_TERRITORY"]}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "properties.reason[0]", "reason_contains": "ED-269 reason"}},
      "why": "FOREIGN_TERRITORY is an ED-269 reason with no ED-318 value (ED-318 adds DAR instead)."
    },
    {
      "name": "refuse-date-time-without-offset",
      "kind": "parse",
      "patch": [{"op": "replace", "path": "/features/2/properties/limitedApplicability/0/startDateTime", "value": "2026-10-01T00:00:00"}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "limitedApplicability[0].startDateTime", "reason_contains": "has no offset"}},
      "why": "A naive time is a programming error (T-09): which instant it means depends on where it is read."
    },
    {
      "name": "refuse-unsupported-geometry",
      "kind": "parse",
      "patch": [{"op": "replace", "path": "/features/4/geometry", "value": {"type": "LineString", "coordinates": [[44.9, 41.75], [44.91, 41.76]]}}],
      "expected": {"accepted": false, "must_include": {"field_endswith": "features[4].geometry.type", "reason_contains": "not supported for a UAS zone"}},
      "why": "A zone is a Polygon, a Point with a Circle extent, or a GeometryCollection of those; a line has no inside."
    },
    {
      "name": "map-mappable-subset-to-ed269",
      "kind": "to_ed269",
      "features": [2, 4],
      "lang": "en-GB",
      "expected": {
        "mapped": true,
        "ed269": {
          "features": [
            {
              "identifier": "TSR001",
              "country": "GEO",
              "name": "Test authorisation zone",
              "type": "COMMON",
              "restriction": "REQ_AUTHORISATION",
              "reason": ["SENSITIVE", "PRIVACY"],
              "message": "Authorisation required on weekdays",
              "applicability": [
                {
                  "permanent": "NO",
                  "startDateTime": "2026-10-01T00:00:00+04:00",
                  "endDateTime": "2027-01-01T00:00:00+04:00",
                  "schedule": [{"day": ["MON", "TUE", "WED", "THU", "FRI"], "startTime": "08:00:00+04:00", "endTime": "18:00:00+04:00"}]
                }
              ],
              "zoneAuthority": [
                {"name": "Test authority", "siteURL": "https://example.invalid/zones", "email": "zones@example.invalid", "purpose": "AUTHORIZATION", "intervalBefore": "P2D"}
              ],
              "geometry": [
                {
                  "uomDimensions": "M",
                  "lowerLimit": 0,
                  "lowerVerticalReference": "AGL",
                  "upperLimit": 600,
                  "upperVerticalReference": "WGS84",
                  "horizontalProjection": {
                    "type": "Polygon",
                    "coordinates": [
                      [[44.8, 41.7], [44.82, 41.7], [44.82, 41.72], [44.8, 41.72], [44.8, 41.7]],
                      [[44.805, 41.705], [44.815, 41.705], [44.815, 41.715], [44.805, 41.715], [44.805, 41.705]]
                    ]
                  }
                }
              ],
              "restrictionConditions": "Authorisation by the authority",
              "extendedProperties": {"source": "test"}
            },
            {
              "identifier": "TSN001",
              "country": "GEO",
              "name": "Test information zone",
              "type": "COMMON",
              "restriction": "NO_RESTRICTION",
              "applicability": [{"permanent": "YES"}],
              "zoneAuthority": [{"purpose": "INFORMATION"}],
              "geometry": [
                {
                  "uomDimensions": "M",
                  "lowerVerticalReference": "AGL",
                  "upperVerticalReference": "AMSL",
                  "horizontalProjection": {"type": "Circle", "center": [44.9, 41.75], "radius": 250.5}
                }
              ]
            }
          ]
        }
      },
      "why": "The mappable subset maps onto ED-269 for legacy consumers: type becomes restriction in ED-269's spelling, variant becomes type, one-language texts become strings, the layer becomes a volume (the WGS84 limit is this project's ED-269 extension, Z-05), no limitedApplicability becomes one permanent period."
    },
    {
      "name": "map-two-languages-to-ed269",
      "kind": "to_ed269",
      "features": [2],
      "lang": "ka-GE",
      "patch": [{"op": "replace", "path": "/features/0/properties/name", "value": [{"text": "Test authorisation zone", "lang": "en-GB"}, {"text": "სატესტო ნებართვის ზონა", "lang": "ka-GE"}]}],
      "expected": {
        "mapped": true,
        "ed269": {
          "features": [
            {
              "identifier": "TSR001",
              "country": "GEO",
              "name": "სატესტო ნებართვის ზონა",
              "type": "COMMON",
              "restriction": "REQ_AUTHORISATION",
              "reason": ["SENSITIVE", "PRIVACY"],
              "message": "Authorisation required on weekdays",
              "applicability": [
                {
                  "permanent": "NO",
                  "startDateTime": "2026-10-01T00:00:00+04:00",
                  "endDateTime": "2027-01-01T00:00:00+04:00",
                  "schedule": [{"day": ["MON", "TUE", "WED", "THU", "FRI"], "startTime": "08:00:00+04:00", "endTime": "18:00:00+04:00"}]
                }
              ],
              "zoneAuthority": [
                {"name": "Test authority", "siteURL": "https://example.invalid/zones", "email": "zones@example.invalid", "purpose": "AUTHORIZATION", "intervalBefore": "P2D"}
              ],
              "geometry": [
                {
                  "uomDimensions": "M",
                  "lowerLimit": 0,
                  "lowerVerticalReference": "AGL",
                  "upperLimit": 600,
                  "upperVerticalReference": "WGS84",
                  "horizontalProjection": {
                    "type": "Polygon",
                    "coordinates": [
                      [[44.8, 41.7], [44.82, 41.7], [44.82, 41.72], [44.8, 41.72], [44.8, 41.7]],
                      [[44.805, 41.705], [44.815, 41.705], [44.815, 41.715], [44.805, 41.715], [44.805, 41.705]]
                    ]
                  }
                }
              ],
              "restrictionConditions": "Authorisation by the authority",
              "extendedProperties": {
                "source": "test",
                "ed269": {"texts": {"name": [{"text": "Test authorisation zone", "lang": "en-GB"}, {"text": "სატესტო ნებართვის ზონა", "lang": "ka-GE"}]}}
              }
            }
          ]
        }
      },
      "why": "ED-269 holds one string per text: the preferred language's (ka-GE here; else English, else the first), and the whole list travels in extendedProperties.ed269.texts so that the way back restores every language (owner decision on PR #16)."
    },
    {
      "name": "refuse-ed269-mapping-uspace",
      "kind": "to_ed269",
      "features": [0],
      "expected": {"mapped": false, "field_endswith": "features[0].properties.type", "reason_contains": "USPACE has no ED-269 restriction"},
      "why": "ED-269 has no U-space airspace type; the zone is refused, not mapped to another restriction."
    },
    {
      "name": "refuse-ed269-mapping-dar",
      "kind": "to_ed269",
      "features": [1],
      "expected": {"mapped": false, "field_endswith": "properties.reason[0]", "reason_contains": "DAR has no ED-269 reason"},
      "why": "DAR (dynamic airspace reconfiguration) is an ED-318 reason only."
    },
    {
      "name": "refuse-ed269-mapping-daylight-event",
      "kind": "to_ed269",
      "features": [2],
      "patch": [{"op": "replace", "path": "/features/0/properties/limitedApplicability/0/schedule/0", "value": {"day": ["ANY"], "startEvent": "SR", "endTime": "18:00:00+04:00"}}],
      "expected": {"mapped": false, "field_endswith": "schedule[0].startEvent", "reason_contains": "ED-269 has clock times only"},
      "why": "ED-269 schedules are clock times; a window that starts at sunrise has no ED-269 form and is not approximated."
    },
    {
      "name": "refuse-ed269-mapping-two-layers",
      "kind": "to_ed269",
      "features": [3],
      "expected": {"mapped": false, "field_endswith": "features[0].geometry.geometries", "reason_contains": "ED-269 holds one volume per zone"},
      "why": "ED-269 zones hold one volume (LESSONS Z-04); a two-layer zone is refused rather than half mapped."
    },
    {
      "name": "map-ed269-zone-to-ed318",
      "kind": "from_ed269",
      "lang": "en-GB",
      "ed269": {
        "features": [
          {
            "identifier": "TST002",
            "country": "GEO",
            "name": "Test circle in feet, AMSL",
            "type": "COMMON",
            "restriction": "REQ_AUTHORISATION",
            "reason": ["POPULATION"],
            "applicability": [{"permanent": "NO", "startDateTime": "2026-01-01T00:00:00Z", "endDateTime": "2027-01-01T00:00:00+04:00"}],
            "zoneAuthority": [{"name": "Test authority", "purpose": "NOTIFICATION"}],
            "geometry": [
              {
                "uomDimensions": "FT",
                "lowerLimit": 1500,
                "lowerVerticalReference": "AMSL",
                "upperLimit": 2500.5,
                "upperVerticalReference": "AMSL",
                "horizontalProjection": {"type": "Circle", "center": [44.7831, 41.6938], "radius": 1640}
              }
            ],
            "restrictionConditions": ["Notify 24 h before"],
            "region": 7,
            "regulationExemption": "NO",
            "uSpaceClass": "EUROCONTROL",
            "extendedProperties": {"source": "test", "revision": 3}
          }
        ]
      },
      "expected": {
        "mapped": true,
        "ed318": {
          "type": "FeatureCollection",
          "features": [
            {
              "type": "Feature",
              "geometry": {
                "type": "Point",
                "coordinates": [44.7831, 41.6938],
                "extent": {"subType": "Circle", "radius": 499.872},
                "layer": {"upper": 2500.5, "upperReference": "AMSL", "lower": 1500, "lowerReference": "AMSL", "uom": "ft"}
              },
              "properties": {
                "identifier": "TST002",
                "country": "GEO",
                "name": [{"text": "Test circle in feet, AMSL", "lang": "en-GB"}],
                "type": "REQ_AUTHORIZATION",
                "variant": "COMMON",
                "restrictionConditions": "Notify 24 h before",
                "region": 7,
                "reason": ["POPULATION"],
                "regulationExemption": "NO",
                "zoneAuthority": [{"name": [{"text": "Test authority", "lang": "en-GB"}], "purpose": "NOTIFICATION"}],
                "limitedApplicability": [{"startDateTime": "2026-01-01T00:00:00Z", "endDateTime": "2027-01-01T00:00:00+04:00"}],
                "extendedProperties": {
                  "source": "test",
                  "revision": 3,
                  "ed269": {"restrictionConditions": ["Notify 24 h before"], "uSpaceClass": "EUROCONTROL"}
                }
              }
            }
          ]
        }
      },
      "why": "ED-269 to ED-318 (spec 02 F1): restriction REQ_AUTHORISATION becomes type REQ_AUTHORIZATION, type becomes variant, applicability becomes limitedApplicability, texts become one-language lists, FT stays the layer's ft and the circle radius becomes metres (1640 ft = 499.872 m, exactly with 0.3048). The ED-269 fields ED-318 has no member for (uSpaceClass, a list of restrictionConditions) travel in extendedProperties.ed269 and return to ED-269 unchanged."
    },
    {
      "name": "applies-between-daylight-events",
      "kind": "applies",
      "features": [1],
      "at": "2026-10-03T10:00:00Z",
      "where": {"lat_deg": 41.7151, "lon_deg": 44.8271},
      "use_daylight": true,
      "expected": {"applies": true, "not_evaluated": false},
      "why": "Between morning and evening civil twilight on a day inside the dates the zone applies; the events are resolved per day at the place."
    },
    {
      "name": "not-applies-after-evening-twilight",
      "kind": "applies",
      "features": [1],
      "at": "2026-10-03T16:00:00Z",
      "where": {"lat_deg": 41.7151, "lon_deg": 44.8271},
      "use_daylight": true,
      "expected": {"applies": false, "not_evaluated": false},
      "why": "After EECT (14:56Z that day) and before the next BMCT the zone does not apply, and that is a judgement, not an unknown: the events of the day before, the day and the day after all resolved."
    },
    {
      "name": "not-evaluated-without-daylight",
      "kind": "applies",
      "features": [1],
      "at": "2026-10-03T10:00:00Z",
      "where": {"lat_deg": 41.7151, "lon_deg": 44.8271},
      "use_daylight": false,
      "expected": {"applies": false, "not_evaluated": true, "reason_contains": "BMCT"},
      "why": "A period that uses an event the place cannot resolve is not evaluated, with a reason, never applies and never silently does not apply."
    },
    {
      "name": "not-applies-after-end-date-without-daylight",
      "kind": "applies",
      "features": [1],
      "at": "2026-10-09T10:00:00Z",
      "where": {"lat_deg": 41.7151, "lon_deg": 44.8271},
      "use_daylight": false,
      "expected": {"applies": false, "not_evaluated": false},
      "why": "Outside the period's dates no event is needed: the zone does not apply, judged, even with no daylight source."
    },
    {
      "name": "applies-without-limited-applicability",
      "kind": "applies",
      "features": [4],
      "at": "2026-10-03T10:00:00Z",
      "where": {"lat_deg": 41.75, "lon_deg": 44.9},
      "use_daylight": false,
      "expected": {"applies": true, "not_evaluated": false},
      "why": "A zone without limitedApplicability applies at all times (ED-318 has no permanent flag)."
    }
  ]
}
